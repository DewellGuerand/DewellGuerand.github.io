---
import { siteConfig } from "../config";

const getSkillIcon = (skillName: string) => {
  const icons: Record<string, string> = {
    "Python": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
    "C": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/c/c-original.svg",
    "C++": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg",
    "Java": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg",
    "Dart": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dart/dart-original.svg",
    "Bash": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bash/bash-original.svg",
    "Julia": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/julia/julia-original.svg",
    "Node.js": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg",
    "TypeScript": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg",
    "JavaScript": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg",
    "Next.js": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg",
    "PostgreSQL": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg",
    "NumPy": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/numpy/numpy-original.svg",
    "Pandas": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pandas/pandas-original.svg",
    "TensorFlow": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tensorflow/tensorflow-original.svg",
    "Git": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg",
  };
  return icons[skillName] || null;
};
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white py-8 lg:py-0 h-full flex items-center"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="absolute inset-0 -z-10 bg-gray-50"></div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 opacity-30"
  >
    <defs>
      <pattern
        x="0"
        y="0"
        id="grid-pattern"
        width={40}
        height={40}
        patternUnits="userSpaceOnUse"
      >
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke-width="1"></path>
      </pattern>
    </defs>
    <rect fill="url(#grid-pattern)" width="100%" height="100%"></rect>
  </svg>

  <div class="w-full mx-auto p-4 sm:p-6 lg:p-8">
    <h1
      class="mt-4 sm:mt-6 md:mt-8 text-pretty text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-gray-800 animate-fade-in animation-delay-200"
    >
      <span style={{ color: siteConfig.accentColor }}>{siteConfig.name}</span>
    </h1>

    <p
      class="mt-3 text-base sm:text-lg font-medium text-gray-500 animate-fade-in animation-delay-400"
    >
      {siteConfig.title}
    </p>

    <div class="mt-6 animate-fade-in animation-delay-600">
      <p class="text-sm sm:text-base leading-relaxed text-gray-600">
        {siteConfig.aboutMe}
      </p>
    </div>

    <!-- Grouped skills -->
    {siteConfig.skillGroups && siteConfig.skillGroups.length > 0 && (
      <div class="mt-8 space-y-5 animate-fade-in animation-delay-600">
        {siteConfig.skillGroups.map((group) => (
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill: string) => {
                const iconUrl = getSkillIcon(skill);
                return (
                  <div class="flex items-center gap-1.5 px-2.5 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium hover:bg-gray-200 transition-colors duration-200">
                    {iconUrl && (
                      <img
                        src={iconUrl}
                        alt={`${skill} icon`}
                        class="w-4 h-4"
                        loading="lazy"
                      />
                    )}
                    <span>{skill}</span>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Languages -->
    {siteConfig.languages && siteConfig.languages.length > 0 && (
      <div class="mt-6 animate-fade-in animation-delay-800">
        <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">
          Languages
        </h3>
        <div class="flex flex-wrap gap-2">
          {siteConfig.languages.map((lang) => (
            <div class="flex items-center gap-2 px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-sm shadow-sm">
              <span class="font-semibold text-gray-800">{lang.name}</span>
              <span
                class="px-1.5 py-0.5 text-xs font-mono rounded text-white"
                style={`background-color: ${siteConfig.accentColor}`}
              >
                {lang.level}
              </span>
              {lang.note && (
                <span class="text-gray-400 text-xs">{lang.note}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 { animation-delay: 0.2s; }
  .animation-delay-400 { animation-delay: 0.4s; }
  .animation-delay-600 { animation-delay: 0.6s; }
  .animation-delay-800 { animation-delay: 0.8s; }
</style>
